# Copy this file to .env and adjust values for your local environment.
# .env is git-ignored — never commit real secrets.

# ----------------------------------------------------------------------
# docker-compose.dev.yml — local PostgreSQL for development
# ----------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ----------------------------------------------------------------------
# docker-compose.yml — production-like stack (app + db)
# ----------------------------------------------------------------------
# DB credentials (DO NOT reuse dev values in production)
DB_USER=springjwt
DB_PASSWORD=change-me-to-a-strong-password

# JWT signing secret (minimum 32 characters; generate with: openssl rand -base64 48)
JWT_SECRET=change-me-to-at-least-32-random-characters!!

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# Host port to expose the app on (default 8080)
HOST_PORT=8080
