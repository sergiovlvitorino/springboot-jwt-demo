# Copy this file to .env and adjust values for your local environment.
# .env is git-ignored — never commit real secrets.

# ----------------------------------------------------------------------
# docker-compose.dev.yml — local PostgreSQL for development
# ----------------------------------------------------------------------
# Any non-empty value works for the dev container; choose your own.
POSTGRES_USER=<set-local-dev-user>
POSTGRES_PASSWORD=<set-local-dev-password>

# ----------------------------------------------------------------------
# docker-compose.yml — production-like stack (app + db)
# ----------------------------------------------------------------------
# DB credentials — generate with a password manager
DB_USER=<set-prod-db-user>
DB_PASSWORD=<set-strong-random-password>

# JWT signing secret — generate with: openssl rand -base64 48
# Minimum 32 characters (enforced at startup)
JWT_SECRET=<paste-output-of-openssl-rand-base64-48>

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# Host port to expose the app on (default 8080)
HOST_PORT=8080
